# Normaliza finais de linha
* text=auto eol=lf

# Arquivos binários (evita diffs/merges corrompidos)
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.aseprite binary
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
