# Configure localmente ou por variaveis de ambiente; nunca versione valores.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# TypeSafe AI / Jev - jogador automatico 3D
# Preencha a chave somente no .env local.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# Painel do site: com o token de uma conta do site (página Minha conta → Tokens do jogo), a
# ponte manda o resumo de cada sessão do jogador automático para o painel do admin.
MYTHSVALLEY_TOKEN=
# MYTHSVALLEY_SITE=https://mythsvalley.app.br
